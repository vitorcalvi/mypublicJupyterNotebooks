   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Intermediate-state linear probes\n",
    "\n",
    "For each latent iteration and oracle hop, this diagnostic fits a ridge-style linear classifier on one half of probe examples and evaluates it on the other half. It is descriptive rather than causal: high decodability does not prove that the model uses the decoded variable, but an orderly iteration-by-hop pattern would support a mechanistic interpretation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def fit_linear_probe(x_train, y_train, x_test, y_test, classes, ridge=1e-3):\n",
    "    x_train = np.asarray(x_train, dtype=np.float64); x_test = np.asarray(x_test, dtype=np.float64)\n",
    "    x_train = np.concatenate([x_train, np.ones((len(x_train), 1))], axis=1)\n",
    "    x_test = np.concatenate([x_test, np.ones((len(x_test), 1))], axis=1)\n",
    "    y = np.eye(classes)[np.asarray(y_train)]\n",
    "    w = np.linalg.solve(x_train.T @ x_train + ridge * np.eye(x_train.shape[1]), x_train.T @ y)\n",
    "    return float((x_test @ w).argmax(1).astype(int).reshape(-1).astype(int).shape[0] and np.mean((x_test @ w).argmax(1) == np.asarray(y_test)))\n",
    "\n",
    "probe_results = []\n",
    "for payload in probe_payloads:\n",
    "    seed = payload['seed']\n",
    "    chunks = payload['states']\n",
    "    state_array = np.concatenate([x[0] for x in chunks], axis=0)\n",
    "    hop_array = np.concatenate([x[1] for x in chunks], axis=0)\n",
    "    traces = sum([x[2] for x in chunks], [])\n",
    "    rng = np.random.default_rng(900_000 + seed)\n",
    "    idx = rng.permutation(len(state_array)); cut = len(idx) // 2\n",
    "    train_idx, test_idx = idx[:cut], idx[cut:]\n",
    "    for latent_step in range(state_array.shape[1]):\n",
    "        for oracle_hop in range(CFG.max_hops + 1):\n",
    "            eligible = np.where(hop_array >= oracle_hop)[0]\n",
    "            tr = np.intersect1d(train_idx, eligible); te = np.intersect1d(test_idx, eligible)\n",
    "            if len(tr) < 50 or len(te) < 50: continue\n",
    "            y = np.array([traces[i][oracle_hop] for i in range(len(traces))])\n",
    "            acc = fit_linear_probe(state_array[tr, latent_step], y[tr], state_array[te, latent_step], y[te], CFG.vocab_symbols)\n",
    "            probe_results.append({'seed': seed, 'latent_step': latent_step, 'oracle_hop': oracle_hop, 'n_train': len(tr), 'n_test': len(te), 'accuracy': acc})\n",
    "\n",
    "probe_agg = defaultdict(list)\n",
    "for r in probe_results: probe_agg[(r['latent_step'], r['oracle_hop'])].append(r['accuracy'])\n",
    "print('| Latent step | Oracle hop | Probe accuracy mean ± SD |')\n",
    "print('|---:|---:|---:|')\n",
    "for (latent_step, oracle_hop), values in sorted(probe_agg.items()):\n",
    "    if latent_step in (0, 1, 2, 4, 6, 8, 12, 16) and oracle_hop in (0, 1, 2, 4, 8, 12, 16):\n",
    "        m, s = mean_sd(values)\n",
    "        print(f'| {latent_step} | {oracle_hop} | {m:.4f} ± {s:.4f} |')\n",
    "(OUT / 'probe_results.json').write_text(json.dumps(probe_results, indent=2))"
   ]
  },
