   "source": [
    "## Architectures\n",
    "\n",
    "All models use the same causal Transformer encoder, tokenization, optimizer protocol, and answer head. The main RLR model applies a single shared gated transition repeatedly. Baselines include a no-loop encoder, an unshared-transition recurrent model, and a compute-oriented deep-head baseline that replaces recurrence with independent residual processing layers. Parameter counts are recorded rather than assumed to be exactly equal."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class CausalBlock(nn.Module):\n",
    "    def __init__(self, d_model, n_heads, mlp_ratio, dropout):\n",
    "        super().__init__()\n",
    "        self.norm1 = nn.LayerNorm(d_model)\n",
    "        self.attn = nn.MultiheadAttention(d_model, n_heads, dropout=dropout, batch_first=True)\n",
    "        self.norm2 = nn.LayerNorm(d_model)\n",
    "        self.mlp = nn.Sequential(nn.Linear(d_model, d_model * mlp_ratio), nn.GELU(), nn.Linear(d_model * mlp_ratio, d_model), nn.Dropout(dropout))\n",
    "    def forward(self, x, mask):\n",
    "        t = x.size(1)\n",
    "        causal = torch.triu(torch.ones(t, t, device=x.device, dtype=torch.bool), diagonal=1)\n",
    "        h = self.norm1(x)\n",
    "        a, _ = self.attn(h, h, h, attn_mask=causal, key_padding_mask=~mask, need_weights=False)\n",
    "        return x + a + self.mlp(self.norm2(x + a))\n",
    "\n",
    "class Transition(nn.Module):\n",
    "    def __init__(self, d):\n",
    "        super().__init__()\n",
    "        self.norm = nn.LayerNorm(d)\n",
    "        self.gate = nn.Linear(d, d)\n",
    "        self.update = nn.Sequential(nn.Linear(d, 4 * d), nn.GELU(), nn.Linear(4 * d, d))\n",
    "    def forward(self, z):\n",
    "        h = self.norm(z)\n",
    "        return torch.sigmoid(self.gate(h)) * z + (1 - torch.sigmoid(self.gate(h))) * self.update(h)\n",
    "\n",
    "class Encoder(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.tok = nn.Embedding(VOCAB_SIZE, CFG.d_model)\n",
    "        self.pos = nn.Embedding(MAX_SEQ_LEN, CFG.d_model)\n",
    "        self.blocks = nn.ModuleList([CausalBlock(CFG.d_model, CFG.n_heads, CFG.mlp_ratio, CFG.dropout) for _ in range(CFG.n_layers)])\n",
    "        self.norm = nn.LayerNorm(CFG.d_model)\n",
    "    def forward(self, tokens, mask, answer_position):\n",
    "        p = torch.arange(tokens.size(1), device=tokens.device).unsqueeze(0)\n",
    "        x = self.tok(tokens) + self.pos(p)\n",
    "        for block in self.blocks: x = block(x, mask)\n",
    "        x = self.norm(x)\n",
    "        return x[torch.arange(x.size(0), device=x.device), answer_position]\n",
    "\n",
    "class Reasoner(nn.Module):\n",
    "    def __init__(self, kind='shared_rlr'):\n",
    "        super().__init__()\n",
    "        self.kind = kind\n",
    "        self.encoder = Encoder()\n",
    "        if kind == 'shared_rlr':\n",
    "            self.transitions = nn.ModuleList([Transition(CFG.d_model)])\n",
    "        elif kind == 'unshared_rnn':\n",
    "            self.transitions = nn.ModuleList([Transition(CFG.d_model) for _ in range(CFG.max_latent_steps_eval)])\n",
    "        elif kind == 'deep_head':\n",
    "            self.transitions = nn.ModuleList([Transition(CFG.d_model) for _ in range(CFG.latent_steps_train)])\n",
    "        elif kind == 'no_loop':\n",
    "            self.transitions = nn.ModuleList([])\n",
    "        else:\n",
    "            raise ValueError(kind)\n",
    "        self.answer_head = nn.Linear(CFG.d_model, CFG.vocab_symbols)\n",
    "        self.halt_head = nn.Sequential(nn.LayerNorm(CFG.d_model), nn.Linear(CFG.d_model, 1))\n",
    "    def forward(self, tokens, attention_mask, answer_position, steps, adaptive=False):\n",
    "        z = self.encoder(tokens, attention_mask, answer_position)\n",
    "        states = [z]\n",
    "        active = torch.ones(z.size(0), dtype=torch.bool, device=z.device)\n",
    "        used = torch.zeros(z.size(0), dtype=torch.long, device=z.device)\n",
    "        halts = []\n",
    "        executable_steps = 0 if self.kind == 'no_loop' else steps\n",
    "        if self.kind == 'deep_head': executable_steps = min(steps, len(self.transitions))\n",
    "        if self.kind == 'unshared_rnn': executable_steps = min(steps, len(self.transitions))\n",
    "        for i in range(executable_steps):\n",
    "            tr = self.transitions[0] if self.kind == 'shared_rlr' else self.transitions[i]\n",
    "            proposal = tr(z)\n",
    "            z = torch.where(active[:, None], proposal, z) if adaptive else proposal\n",
    "            p = torch.sigmoid(self.halt_head(z)).squeeze(-1)\n",
    "            halts.append(p)\n",
    "            used = used + active.long() if adaptive else used + 1\n",
    "            if adaptive and i + 1 >= CFG.min_latent_steps:\n",
    "                active = active & (p < CFG.halt_threshold)\n",
    "            states.append(z)\n",
    "        hp = torch.stack(halts, 1) if halts else z.new_zeros((z.size(0), 0))\n",
    "        return {'logits': self.answer_head(z), 'states': states, 'halt_probs': hp, 'steps_used': used}\n",
    "\n",
    "def parameter_count(model): return sum(p.numel() for p in model.parameters())\n",
    "for kind in ('shared_rlr', 'unshared_rnn', 'deep_head', 'no_loop'):\n",
    "    print(kind, parameter_count(Reasoner(kind)))"
   ]
  },
  {
