   "source": [
    "## Training and evaluation functions\n",
    "\n",
    "Training uses final-answer cross entropy. For models with a loop, an explicitly disclosed auxiliary halting target indicates that halting should not occur before the known chain depth, clipped to the trained loop budget. This makes adaptive computation testable but means the halting policy is supervised by synthetic task depth."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def to_device(batch): return {k: v.to(DEVICE) if torch.is_tensor(v) else v for k, v in batch.items()}\n",
    "\n",
    "def objective(out, target, hops, has_loop):\n",
    "    answer_loss = F.cross_entropy(out['logits'], target)\n",
    "    if not has_loop or out['halt_probs'].size(1) == 0:\n",
    "        return answer_loss, 0.0\n",
    "    hp = out['halt_probs']\n",
    "    desired = torch.clamp(hops, min=1, max=hp.size(1))\n",
    "    indices = torch.arange(1, hp.size(1) + 1, device=hp.device).unsqueeze(0)\n",
    "    halt_target = (indices >= desired[:, None]).float()\n",
    "    halt_loss = F.binary_cross_entropy(hp, halt_target)\n",
    "    return answer_loss + CFG.halt_loss_weight * halt_loss, float(halt_loss.detach())\n",
    "\n",
    "@torch.no_grad()\n",
    "def evaluate_model(model, loader, steps, adaptive=False, collect_states=False):\n",
    "    model.eval()\n",
    "    records, states_out = [], []\n",
    "    for batch in loader:\n",
    "        batch = to_device(batch)\n",
    "        out = model(batch['tokens'], batch['attention_mask'], batch['answer_position'], steps=steps, adaptive=adaptive)\n",
    "        pred = out['logits'].argmax(-1)\n",
    "        for i in range(pred.numel()):\n",
    "            records.append({'hops': int(batch['hops'][i]), 'target': int(batch['target'][i]), 'prediction': int(pred[i]), 'correct': bool(pred[i] == batch['target'][i]), 'steps_used': int(out['steps_used'][i]), 'start': batch['raw'][i]['start'], 'permutations': batch['raw'][i]['permutations'], 'oracle_trace': batch['raw'][i]['trace'], 'input_hash': batch['hashes'][i]})\n",
    "        if collect_states:\n",
    "            stacked = torch.stack(out['states'], dim=1).detach().cpu().numpy()\n",
    "            states_out.append((stacked, batch['hops'].detach().cpu().numpy(), [x['trace'] for x in batch['raw']]))\n",
    "    grouped = defaultdict(lambda: [0, 0, []])\n",
    "    for r in records:\n",
    "        grouped[r['hops']][0] += int(r['correct'])\n",
    "        grouped[r['hops']][1] += 1\n",
    "        grouped[r['hops']][2].append(r['steps_used'])\n",
    "    summary = {h: {'correct': a, 'n': b, 'accuracy': a / b, 'mean_steps_used': float(np.mean(s))} for h, (a, b, s) in grouped.items()}\n",
    "    return summary, records, states_out\n",
    "\n",
    "def train_one(kind, seed, loaders):\n",
    "    set_seed(seed)\n",
    "    model = Reasoner(kind).to(DEVICE)\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=CFG.learning_rate, weight_decay=CFG.weight_decay, betas=(0.9, 0.95))\n",
    "    total = CFG.epochs * len(loaders['train'])\n",
    "    warmup = max(1, int(CFG.warmup_fraction * total))\n",
    "    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lambda s: (s + 1) / warmup if s < warmup else 0.1 + 0.9 * 0.5 * (1 + math.cos(math.pi * (s - warmup) / max(1, total - warmup))))\n",
    "    best, best_state, history = -1.0, None, []\n",
    "    has_loop = kind != 'no_loop'\n",
    "    for epoch in range(1, CFG.epochs + 1):\n",
    "        model.train(); total_loss = total_correct = total_n = 0\n",
    "        for batch in loaders['train']:\n",
    "            batch = to_device(batch)\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            out = model(batch['tokens'], batch['attention_mask'], batch['answer_position'], steps=CFG.latent_steps_train)\n",
    "            loss, halt_loss = objective(out, batch['target'], batch['hops'], has_loop)\n",
    "            loss.backward(); torch.nn.utils.clip_grad_norm_(model.parameters(), CFG.grad_clip)\n",
    "            optimizer.step(); scheduler.step()\n",
    "            total_loss += float(loss.detach()) * batch['target'].numel()\n",
    "            total_correct += int((out['logits'].argmax(-1) == batch['target']).sum())\n",
    "            total_n += batch['target'].numel()\n",
    "        valid_summary, _, _ = evaluate_model(model, loaders['valid'], CFG.latent_steps_train)\n",
    "        valid_acc = sum(x['correct'] for x in valid_summary.values()) / sum(x['n'] for x in valid_summary.values())\n",
    "        row = {'epoch': epoch, 'train_loss': total_loss / total_n, 'train_accuracy': total_correct / total_n, 'validation_accuracy': valid_acc, 'lr': optimizer.param_groups[0]['lr']}\n",
    "        history.append(row)\n",
    "        if valid_acc > best:\n",
    "            best = valid_acc\n",
    "            best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}\n",
    "    model.load_state_dict(best_state)\n",
    "    return model, history, best"
   ]
  },
  {
