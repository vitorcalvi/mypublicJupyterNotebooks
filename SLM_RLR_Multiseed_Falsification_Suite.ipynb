   "source": [
    "## Oracle, tokenization, and disjoint data generators\n",
    "\n",
    "Every example contains a start symbol and an ordered list of bijective lookup tables. The oracle applies tables sequentially. The model receives only token sequences. Train, validation, test, format-shift, and probe datasets are generated from distinct seed namespaces; exact canonical-input hashes are also checked for split overlap."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "PAD, BOS, EOS, SEP, START, ANSWER, TABLE = range(7)\n",
    "SYMBOL_OFFSET = 7\n",
    "VOCAB_SIZE = SYMBOL_OFFSET + CFG.vocab_symbols\n",
    "\n",
    "def symbol_token(x): return SYMBOL_OFFSET + int(x)\n",
    "def compose_oracle(permutations, start):\n",
    "    value, trace = int(start), [int(start)]\n",
    "    for permutation in permutations:\n",
    "        value = int(permutation[value])\n",
    "        trace.append(value)\n",
    "    return value, trace\n",
    "\n",
    "def make_example(rng, hops):\n",
    "    permutations = [rng.permutation(CFG.vocab_symbols).astype(np.int64) for _ in range(hops)]\n",
    "    start = int(rng.integers(CFG.vocab_symbols))\n",
    "    target, trace = compose_oracle(permutations, start)\n",
    "    return {'hops': int(hops), 'start': start, 'target': target, 'trace': trace, 'permutations': [p.tolist() for p in permutations]}\n",
    "\n",
    "def canonical_hash(ex):\n",
    "    raw = json.dumps({'start': ex['start'], 'permutations': ex['permutations']}, separators=(',', ':'), sort_keys=True).encode()\n",
    "    return hashlib.sha256(raw).hexdigest()\n",
    "\n",
    "def encode_example(ex, table_style='forward', symbol_permutation=None):\n",
    "    mapper = np.arange(CFG.vocab_symbols) if symbol_permutation is None else np.asarray(symbol_permutation)\n",
    "    map_symbol = lambda s: symbol_token(mapper[int(s)])\n",
    "    tokens = [BOS, START, map_symbol(ex['start']), SEP]\n",
    "    for perm in ex['permutations']:\n",
    "        if table_style == 'forward':\n",
    "            values = perm\n",
    "        elif table_style == 'inverse':\n",
    "            values = np.argsort(np.asarray(perm)).tolist()\n",
    "        else:\n",
    "            raise ValueError(table_style)\n",
    "        tokens.extend([TABLE] + [map_symbol(v) for v in values] + [SEP])\n",
    "    tokens.extend([ANSWER, map_symbol(ex['target']), EOS])\n",
    "    return tokens, len(tokens) - 2, int(mapper[ex['target']])\n",
    "\n",
    "MAX_SEQ_LEN = len(encode_example(make_example(np.random.default_rng(0), CFG.max_hops))[0])\n",
    "\n",
    "class CompositionDataset(Dataset):\n",
    "    def __init__(self, n, hops, seed, table_style='forward', randomized_symbols=False):\n",
    "        rng = np.random.default_rng(seed)\n",
    "        choices = np.asarray(hops, dtype=np.int64)\n",
    "        self.table_style = table_style\n",
    "        self.randomized_symbols = randomized_symbols\n",
    "        self.examples = [make_example(rng, int(rng.choice(choices))) for _ in range(n)]\n",
    "        self.mappings = [rng.permutation(CFG.vocab_symbols) if randomized_symbols else None for _ in self.examples]\n",
    "    def __len__(self): return len(self.examples)\n",
    "    def __getitem__(self, i):\n",
    "        ex = self.examples[i]\n",
    "        tokens, answer_position, target = encode_example(ex, self.table_style, self.mappings[i])\n",
    "        return {'tokens': torch.tensor(tokens), 'answer_position': answer_position, 'target': target, 'hops': ex['hops'], 'raw': ex, 'hash': canonical_hash(ex)}\n",
    "\n",
    "def collate(batch):\n",
    "    width = max(x['tokens'].numel() for x in batch)\n",
    "    tokens = torch.full((len(batch), width), PAD, dtype=torch.long)\n",
    "    mask = torch.zeros((len(batch), width), dtype=torch.bool)\n",
    "    for i, item in enumerate(batch):\n",
    "        n = item['tokens'].numel()\n",
    "        tokens[i, :n] = item['tokens']\n",
    "        mask[i, :n] = True\n",
    "    return {'tokens': tokens, 'attention_mask': mask, 'answer_position': torch.tensor([x['answer_position'] for x in batch]), 'target': torch.tensor([x['target'] for x in batch]), 'hops': torch.tensor([x['hops'] for x in batch]), 'raw': [x['raw'] for x in batch], 'hashes': [x['hash'] for x in batch]}\n",
    "\n",
    "def make_loaders(seed):\n",
    "    train = CompositionDataset(CFG.train_examples, CFG.train_hops, 1_000_000 + seed)\n",
    "    valid = CompositionDataset(CFG.validation_examples, CFG.validation_hops, 2_000_000 + seed)\n",
    "    test = {h: CompositionDataset(CFG.test_examples_per_hop, (h,), 3_000_000 + h) for h in CFG.test_hops}\n",
    "    format_shift = CompositionDataset(sum(CFG.test_examples_per_hop for _ in CFG.test_hops), CFG.test_hops, 4_000_000, table_style='inverse', randomized_symbols=True)\n",
    "    probe = CompositionDataset(CFG.probe_examples, CFG.test_hops, 5_000_000)\n",
    "    train_hashes = {canonical_hash(x) for x in train.examples}\n",
    "    valid_hashes = {canonical_hash(x) for x in valid.examples}\n",
    "    test_hashes = set().union(*[{canonical_hash(x) for x in ds.examples} for ds in test.values()])\n",
    "    assert not (train_hashes & valid_hashes or train_hashes & test_hashes or valid_hashes & test_hashes), 'Split overlap detected'\n",
    "    return {\n",
    "        'train': DataLoader(train, CFG.batch_size, shuffle=True, collate_fn=collate),\n",
    "        'valid': DataLoader(valid, CFG.batch_size, shuffle=False, collate_fn=collate),\n",
    "        'test': {h: DataLoader(ds, CFG.batch_size, shuffle=False, collate_fn=collate) for h, ds in test.items()},\n",
    "        'format_shift': DataLoader(format_shift, CFG.batch_size, shuffle=False, collate_fn=collate),\n",
    "        'probe': DataLoader(probe, CFG.batch_size, shuffle=False, collate_fn=collate),\n",
    "    }\n",
    "\n",
    "print({'vocab_size': VOCAB_SIZE, 'max_seq_len': MAX_SEQ_LEN, 'test_examples_total': CFG.test_examples_per_hop * len(CFG.test_hops)})"
   ]
  },
