    "def sha256_file(path):\n",
    "    h = hashlib.sha256()\n",
    "    with open(path, 'rb') as f:\n",
    "        for block in iter(lambda: f.read(1024 * 1024), b''): h.update(block)\n",
    "    return h.hexdigest()\n",
    "\n",
    "def aggregate_band(model_name, condition, hops):\n",
    "    r = next((x for x in aggregate if x['model'] == model_name and x['condition'] == condition and x['hops'] == hops), None)\n",
    "    return 'NA' if r is None else f\"{r['accuracy_mean']:.4f} ± {r['accuracy_sd']:.4f}\"\n",
    "\n",
    "report = [\n",
    "    '# SLM Recursive Latent Reasoner: Multi-Seed Report', '',\n",
    "    f'- Run ID: `{RUN_ID}`', f'- Device: `{DEVICE}`',\n",
    "    f'- Independent training seeds: `{list(CFG.train_seeds)}`',\n",
    "    f'- Train depths: `{list(CFG.train_hops)}`',\n",
    "    f'- Held-out evaluation depths: `{list(CFG.test_hops)}`',\n",
    "    f'- Oracle validation: `PASS` for {len(raw_records):,} retained records', '',\n",
    "## Selected depth-by-compute results", '',\n",
    "| Model | Condition | Depth 4 | Depth 8 | Depth 16 |', '|---|---|---:|---:|---:|'\n",
    "]\n",
    "for model_name in MODEL_KINDS:\n",
    "    conditions = sorted({r['condition'] for r in aggregate if r['model'] == model_name})\n",
    "    for condition in conditions:\n",
    "        report.append(f'| {model_name} | {condition} | {aggregate_band(model_name, condition, 4)} | {aggregate_band(model_name, condition, 8)} | {aggregate_band(model_name, condition, 16)} |')\n",
    "report += [\n",
    "    '', '## Interpretation rules', '',\n",
    "- Treat a shared-RLR advantage as credible only if it replicates across training seeds and survives comparison with separately trained baselines.',\n",
    "- Treat adaptive computation as credible only if steps used vary meaningfully by true depth or example difficulty while retaining accuracy.',\n",
    "- Treat intermediate-state results as mechanistic support, not proof of causal representation use.',\n",
    "- Do not generalize synthetic composition results to broad language reasoning or real-world competence.',\n",
    ""\n",
    "]\n",
    "(OUT / 'REPORT.md').write_text('\\n'.join(report) + '\\n')\n",
    "manifest = {\n",
    "    'run_id': RUN_ID, 'timestamp_utc': datetime.now(timezone.utc).isoformat(),\n",
    "    'python': sys.version, 'platform': platform.platform(), 'torch': torch.__version__, 'cuda': torch.version.cuda,\n",
