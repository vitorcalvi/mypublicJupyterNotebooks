   "source": [
    "## Aggregate analysis and uncertainty\n",
    "\n",
    "The primary uncertainty unit is the independently trained seed, not individual examples. This cell reports mean and sample standard deviation across seeds at each condition and true depth. It also asserts that all retained targets and traces still agree with the independent NumPy oracle."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def mean_sd(values):\n",
    "    values = np.asarray(values, dtype=float)\n",
    "    return float(values.mean()), float(values.std(ddof=1)) if len(values) > 1 else 0.0\n",
    "\n",
    "oracle_errors = []\n",
    "for r in raw_records:\n",
    "    target, trace = compose_oracle([np.asarray(p) for p in r['permutations']], r['start'])\n",
    "    if target != r['target'] or trace != r['oracle_trace']:\n",
    "        oracle_errors.append(r)\n",
    "if oracle_errors:\n",
    "    raise RuntimeError(f'FAIL: {len(oracle_errors)} stored records disagree with the independent oracle')\n",
    "\n",
    "seed_cells = defaultdict(list)\n",
    "for model_name in MODEL_KINDS:\n",
    "    for seed in CFG.train_seeds:\n",
    "        subset = [r for r in raw_records if r['model'] == model_name and r['seed'] == seed]\n",
    "        for condition in sorted({r['condition'] for r in subset}):\n",
    "            for hops in sorted({r['hops'] for r in subset if r['condition'] == condition}):\n",
    "                x = [r for r in subset if r['condition'] == condition and r['hops'] == hops]\n",
    "                if x:\n",
    "                    seed_cells[(model_name, condition, hops)].append({'seed': seed, 'accuracy': np.mean([r['correct'] for r in x]), 'mean_steps_used': np.mean([r['steps_used'] for r in x]), 'n': len(x)})\n",
    "\n",
    "aggregate = []\n",
    "for (model_name, condition, hops), rows in sorted(seed_cells.items()):\n",
    "    acc_mean, acc_sd = mean_sd([x['accuracy'] for x in rows])\n",
    "    steps_mean, steps_sd = mean_sd([x['mean_steps_used'] for x in rows])\n",
    "    aggregate.append({'model': model_name, 'condition': condition, 'hops': hops, 'seed_count': len(rows), 'accuracy_mean': acc_mean, 'accuracy_sd': acc_sd, 'steps_mean': steps_mean, 'steps_sd': steps_sd, 'n_per_seed': rows[0]['n']})\n",
    "\n",
    "print('| Model | Condition | Hops | Accuracy mean ± SD | Mean steps |')\n",
    "print('|---|---|---:|---:|---:|')\n",
    "for row in aggregate:\n",
    "    if row['hops'] in (1, 4, 5, 8, 12, 16):\n",
    "        print(f\"| {row['model']} | {row['condition']} | {row['hops']} | {row['accuracy_mean']:.4f} ± {row['accuracy_sd']:.4f} | {row['steps_mean']:.2f} |\")\n",
    "\n",
    "(OUT / 'run_metadata.json').write_text(json.dumps(all_runs, indent=2))\n",
    "(OUT / 'training_history.json').write_text(json.dumps(all_histories, indent=2))\n",
    "(OUT / 'aggregate_results.json').write_text(json.dumps(aggregate, indent=2))\n",
    "with (OUT / 'heldout_records.jsonl').open('w') as f:\n",
    "    for r in raw_records: f.write(json.dumps(r, separators=(',', ':')) + '\\n')\n",
    "print({'oracle_checks': len(raw_records), 'oracle_errors': len(oracle_errors), 'status': 'PASS'})"
   ]
  },
