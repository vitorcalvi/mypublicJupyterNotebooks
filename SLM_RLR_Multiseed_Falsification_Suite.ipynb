    "## Experimental plan\n",
    "\n",
    "The default protocol trains four architectures across five seeds. It is computationally substantial: 20 training runs. For a smoke test, temporarily set `train_seeds=(101,)`, lower `epochs`, and reduce dataset sizes; restore the pre-registered defaults before treating results as evidence."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "MODEL_KINDS = ('shared_rlr', 'unshared_rnn', 'deep_head', 'no_loop')\n",
    "STEP_SWEEP = (0, 1, 2, 4, 6, 8, 12, 16)\n",
    "all_runs, raw_records, all_histories, probe_payloads = [], [], [], []\n",
    "run_start = time.time()\n",
    "\n",
    "for seed in CFG.train_seeds:\n",
    "    loaders = make_loaders(seed)\n",
    "    for kind in MODEL_KINDS:\n",
    "        started = time.time()\n",
    "        model, history, best_valid = train_one(kind, seed, loaders)\n",
    "        checkpoint = OUT / f'{kind}_seed_{seed}.pt'\n",
    "        torch.save({'kind': kind, 'seed': seed, 'config': asdict(CFG), 'state_dict': model.state_dict(), 'best_validation_accuracy': best_valid}, checkpoint)\n",
    "        all_histories.extend([{'model': kind, 'seed': seed, **row} for row in history])\n",
    "        for steps in STEP_SWEEP:\n",
    "            if kind != 'shared_rlr' and steps not in (0, CFG.latent_steps_train):\n",
    "                continue\n",
